{
	"name"        : "jmf/time",
	"type"        : "library",
	"license"     : "MIT",
	"description" : "Time package to retrieve and measure time. Provides an implementation of the PSR-20 clock interface.",
	"require"     : {
		"php" : ">=8.3",
		"psr/clock": "^1.0"
	},
	"require-dev": {
        "overtrue/phplint": "^9.7",
        "phpstan/phpstan": "^2.1.22",
        "phpstan/phpstan-strict-rules": "^2.0.6",
        "phpunit/phpunit": "^12.3.6",
        "rector/rector": "^2.1.4",
        "squizlabs/php_codesniffer": "^4.0"
	},
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true
    },
	"autoload" : {
		"psr-4" : {
			"Jmf\\Time\\" : "src/"
		}
	},
	"autoload-dev" : {
		"psr-4" : {
			"Jmf\\Time\\" : "tests/src/"
		}
	},
	"provide": {
		"psr/clock-implementation": "^1.0"
	}
}
