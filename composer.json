{
	"name"        : "jmf/time",
	"type"        : "library",
	"license"     : "MIT",
	"description" : "Time package to retrieve and measure time. Provides an implementation of the PSR-20 clock interface.",
	"require"     : {
		"php" : ">=8.3",
		"psr/clock": "^1.0"
	},
	"require-dev": {
		"phpunit/phpunit": "^12.5",
		"squizlabs/php_codesniffer": "^4.0",
		"rector/rector": "^2.3",
		"phpstan/phpstan": "^2.1",
		"overtrue/phplint": "^9.7"
	},
	"autoload" : {
		"psr-4" : {
			"Jmf\\Time\\" : "src/"
		}
	},
	"autoload-dev" : {
		"psr-4" : {
			"Jmf\\Time\\" : "tests/src/"
		}
	},
	"provide": {
		"psr/clock-implementation": "^1.0"
	}
}
